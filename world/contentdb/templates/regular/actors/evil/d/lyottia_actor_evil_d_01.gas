[t:template,n:lyottia_01_wolf]
{
	category_name = "1W_evil_d";
	doc = "Lyottia 01 Wolf";
	specializes = base_wolf;
	[actor]
	{
		[skills]
		{
			strength =  4, 0;
			intelligence =  1, 0;
			dexterity =  5, 0;
            melee =  1,  0;
		}
	}
	aspect:textures:0 = b_c_edm_wolf_lyottia_02;
	[aspect]
	{
		experience_value = 7;
		life = 9;
        max_life = 9;
        mana = 2;
        max_mana = 2;
        textures:0 = b_c_edm_wolf_lyottia_02;

		[textures]
		{
			0 = b_c_edm_wolf_lyottia_02;
		}

        scale_base = 0.71;
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 6;
		damage_min = 3;
	}

	[defend] { defense=9; }
	[common]
	{
		screen_name="Wolf";
		membership = monster, party_wolf_gray_boss;
	}
	[mind]
	{
		jat_brain						= world\ai\jobs\common\brain_hero.skrit
			?actor_joins_existing_party	= true
			&actor_creates_own_party	= true
			&party_template				= "party_wolf_gray_boss";

		jat_attack_object_melee	= world\ai\jobs\common\job_attack_object_melee.skrit
			?cautious_chance	= 0.9
			&min_cautious_distance = 2.00
			&cautious_approach_distance = 1.25;

	}
}
[t:template,n:lyottia_01_wolf_boss_01]
{
	category_name = "1W_evil_d";
	doc = "Lyottia 01 Wolf Boss 01";
	specializes = base_wolf;
	[actor]
	{
		[skills]
		{
			strength =  5, 0;
			intelligence =  2, 0;
			dexterity =  8, 0;
            melee =  4, 0;
		}
	}
	[aspect]
	{
		experience_value = 33;
		life = 24;
        max_life = 24;
        mana = 2;
        max_mana = 2;
        textures:0 = b_c_edm_wolf_lyottia_01;
        scale_base = 0.93;
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 9;
		damage_min = 6;
	}

	[defend] { defense=16; }
	[common]
	{
		screen_name="Alpha Wolf";
		membership = monster,immune_charm,immune_control,immune_freeze,immune_polymorph,immune_align_change,immune_explode;
		[template_triggers]
		{
			[*]
			{
				condition* 	= receive_world_message("WE_ENTERED_WORLD");
				single_shot = true;
				no_trig_bits = true;
				action* 	= call_sfx_script("unique_ray_blue(sgx)");
				action* 	= call_sfx_script("unique_light_blue(sgx)");
			}

		}

	}

	[mind]
	{
		jat_fidget						= world\ai\jobs\common\job_fidget.skrit
			?still							= false;

		jat_brain						= world\ai\jobs\common\brain_hero.skrit
			?actor_creates_own_party			= true
			&form_party_on_friend_entered_OCZ	= true
			&form_party_on_friend_entered_ICZ	= true
			&party_template						= "party_wolf_gray_boss";
	}
}
[t:template,n:lyottia_01_mangler]
{
	category_name = "1W_evil_d";
	doc = "Lyottia 01 Mangler";
	specializes = base_mangler;
	[actor]
	{
		[skills]
		{
			strength = 	4, 0;
			intelligence = 	2, 0;
			dexterity = 	3, 0;
			melee = 1, 0;
		}
	}
	[aspect]
	{
		experience_value = 6;
		life = 7;
		max_life = 7;
		mana = 4;
		max_mana = 4;
		scale_base = 0.40;
		[textures]	{0=b_c_edm_mn_lyottia_01;}
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 4;
		damage_min = 2;
	}
	[common] { screen_name="Waliz"; }
	[defend] { defense=0; }
	[mind] 
	{ 
		jat_fidget	= world\ai\jobs\common\job_fidget.skrit;
        personal_space_range = 0.2;
	}
}
[t:template,n:lyottia_01_googore_grub]
{
    category_name = "1W_evil_d";
	doc = "Lyottia 01 Googore Grub";
	specializes = actor_evil;
	[actor]
	{
		race	= other;

		[skills]
		{
			strength =  	4, 0;
			intelligence =  1, 0;
			dexterity =  	4, 0;
			melee =  		1, 0;
		}
	}
	[aspect]
	{
		draw_shadow = false;
		model			= m_c_edm_gb_pos_1;
		experience_value	= 2;
		life				= 3;
		max_life			= 3;
		mana = 1;
        max_mana = 1;
		scale_base = 0.22;
        [voice]
		{
			[die] { * = s_e_die_googore_grub; }
		}
	}
	[attack]
	{
		damage_min		= 6;
		damage_max		= 4;
		attack_range	= 0.5;
	}

	[body]
	{
		avg_move_velocity = .65;
        [bone_translator]
		{
			 kill_bone			= bone01;
			 weapon_bone		= spine_1;
			 shield_bone		= spine_1;
			 body_anterior		= spine_1;
			 body_mid			= spine_3;
			 body_posterior		= spine_5;
		}
		[chore_dictionary]
		{
			chore_prefix = a_c_edm_gb_fs;

			[chore_attack]
			{
				skrit = select_attack;
				chore_stances = 0;

				anim_files:00 = at;
				anim_files:01 = at-02;
			}

			[chore_die]
			{
				skrit = select_transition;
				chore_stances = 0;

				anim_files:00 = di;
			}

			[chore_default]
			{
				skrit = infinite_loop;
				chore_stances = 0;

				anim_files:00 = dfs;
			}

			[chore_fidget]
			{
				skrit = select_fidget;
				chore_stances = 0;

				anim_files:00 = dff;
				anim_files:01 = dff-02;
			}

			[chore_walk]
			{
				skrit = select_walk;
				chore_stances = 0;

				anim_files:00 = wl;
				anim_files:01 = wl-02;
			}
		}
	}
	[common] { screen_name = "Maggot"; }
	[defend] { defense=10; }
	[mind]
	{
		jat_fidget	= world\ai\jobs\common\job_fidget.skrit;
		
		melee_engage_range  	= 17;
		personal_space_range	= 0.7;
		ranged_engage_range 	= 17.0;
		sight_range				= 17.0;
	}
	[physics]
	{
		explode_when_killed = false;
	}
}